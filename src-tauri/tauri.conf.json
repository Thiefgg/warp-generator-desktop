{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WARP Generator",
  "version": "0.2.9",
  "identifier": "ru.sakeen.warpgenerator",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,

    "windows": [
      {
        "label": "main",
        "title": "WARP Generator",
        "width": 1200,
        "height": 760,
        "minWidth": 1200,
        "minHeight": 760,
        "maxWidth": 1200,
        "maxHeight": 760,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "transparent": false,
        "backgroundColor": "#090809",
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sakeenkok",
    "copyright": "© 2026 Sakeenkok",
    "category": "Utility",
    "shortDescription": "WARP and AmneziaWG config generator",
    "longDescription": "Desktop application for generating Cloudflare WARP and AmneziaWG configurations.",
    "externalBin": ["binaries/usque"],
    "resources": {
      "binaries/wintun.dll": "."
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}